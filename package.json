{
  "name": "re0",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:integration": "./scripts/test-integration.sh",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker exec -it re0-dev-pg psql -U postgres -d re0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset-dev": "tsx scripts/reset-dev-database.mts",
    "db:prepare-preview": "tsx scripts/reset-dev-database.mts --preview",
    "db:studio": "drizzle-kit studio",
    "paddle:replay": "tsx scripts/paddle-replay.mts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.41",
    "@ai-sdk/react": "^4.0.90",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.0.1",
    "@remotion/media": "4.0.536",
    "@remotion/player": "4.0.536",
    "@remotion/web-renderer": "4.0.536",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.87",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.10",
    "mcp-handler": "^2.3.1",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "4.0.536",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@next/env": "^15.5.4",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12",
    "ws": "^8.21.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": ">=0.35.5",
    "esbuild": ">=0.25.0",
    "zod": "$zod"
