{
  "buildCommand": "npm run build && if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:deploy; fi",
  "git": {
    "deploymentEnabled": {
      "develop": false,
      "rebuild": false,
      "claude/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/charge-storage",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/purge-trash",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/expire-plan",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/plan-redemptions",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/rank",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/reembed",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/purge-kyc-files",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/abandon-exports",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/purge-uploads",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/cron/release-chat-holds",
      "schedule": "*/5 * * * *"
    }
  ]
}
