{
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ] || [ \"$VERCEL_ENV\" = \"preview\" ]; then npm run db:migrate; fi && npm run build",
  "crons": [
    {
      "path": "/api/cron/drain",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/anchor",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "17 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "develop": false
    }
  }
}
