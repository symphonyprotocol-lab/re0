{
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then npm run db:prepare-preview; fi && if [ \"$VERCEL_ENV\" = \"production\" ] || [ \"$VERCEL_ENV\" = \"preview\" ]; then npm run db:migrate; fi && npm run build",
  "git": {
    "deploymentEnabled": {
      "develop": false,
      "claude/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge-trash",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/expire-plan",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/rank",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/reembed",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/purge-kyc-files",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/abandon-exports",
      "schedule": "*/15 * * * *"
    }
  ]
}
